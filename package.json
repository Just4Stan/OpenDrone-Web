{
  "name": "opendrone-web",
  "private": false,
  "sideEffects": false,
  "version": "2026.1.2",
  "type": "module",
  "license": "MIT",
  "homepage": "https://opendrone.be",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incutec-hw/OpenDrone-Web.git"
  },
  "bugs": {
    "url": "https://github.com/incutec-hw/OpenDrone-Web/issues"
  },
  "scripts": {
    "prebuild": "npm run sync:legal",
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "check:registry": "node --experimental-strip-types scripts/check-registry.mjs",
    "sync:legal": "node scripts/sync-legal.mjs",
    "compose:newsletter": "node scripts/compose-newsletter.mjs",
    "publish:post": "node scripts/publish-post.mjs",
    "gen:shopify-templates": "node scripts/shopify-templates/gen.mjs",
    "audit:mobile": "node scripts/mobile-shots.mjs",
    "gen:board-art": "node scripts/export-board-art.mjs --all",
    "gen:components": "node scripts/export-board-art.mjs --all --components-only",
    "gen:schematics": "node scripts/export-schematics.mjs --all"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@shopify/hydrogen": "^2026.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "graphql": "^16.14.2",
    "isbot": "^5.1.44",
