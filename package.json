      "esbuild": "0.28.1"
    },
    "@shopify/mini-oxygen": {
      "undici": "^7.28.0"
    },
    "miniflare": {
      "undici": "^6.27.0",
      "ws": "^8.21.0",
      "youch": {
        "cookie": "^0.7.0"
      }
    }
  }
}
